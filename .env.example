# Copy this file to .env and fill it in. Never commit .env.
# The README explains where each value comes from.

# Postgres on Neon. Use the POOLED connection string (host contains "-pooler"),
# with the password included.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Corsair's key-encryption key (KEK). It encrypts every stored OAuth secret and
# token, and signs session cookies. Generate it once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use the same value in every environment that shares this database. If it is
# lost or changed, every stored credential becomes unreadable.
CORSAIR_KEK=

# Where Google returns after the Gmail / Calendar / Meet consent screen.
# Leave empty locally: it falls back to http://localhost:3000/oauth/callback.
# Required in production, for example:
#   https://your-app.vercel.app/oauth/callback
CORSAIR_OAUTH_REDIRECT_URI=

# Optional. Where Google returns after sign-in. Derived from the request origin
# when unset, which is right unless you sit behind a proxy.
# GOOGLE_SIGNIN_REDIRECT_URI=

# Optional, for the assistant. Free key, no card: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Any Gemini model id. Default: gemini-3.5-flash-lite
# CHAT_MODEL=
